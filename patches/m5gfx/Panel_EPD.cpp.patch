+  // ══════════════════════════════════════════════════════════════
+  // m5ui fast path —— 与上面两个**逐点等价**，只把循环不变量提出去。
+  //
+  // 原版每个像素要做：swap 分支 + 两次条件取反 + 一次 y*stride 乘法。
+  // 但这四个变换在 (i,j) 上是**仿射**的 → 每行起点 + 每像素固定增量就够。
+  //
+  // 等价性不是"看着像"：下面先用**与原版逐字相同**的表达式算出
+  // (i=0,j=0)、(i=1,j=0)、(i=0,j=1) 三点，三点之差即 ax/ay（每像素）与 bx/by（每行）。
+  // 整数运算 + 仿射 ⇒ 每个像素落到的 (x,y) 与原版逐点相同。
+  // 开机还有一次自检（plugin.cpp）：全屏 out 两版 memcmp，不等就不启用快版。
+  // ══════════════════════════════════════════════════════════════
+  // ★★ -O3：本文件在 IDF 里是 -Og（调试级）编的 —— 而这里逐像素跑 518K 次，
+  //    -Og 的代码质量差好几倍。m5gfx 作者自己给热路径（_draw_pixels / blit_dmabuf）
+  //    也是这么加的。实测这一步比任何循环重排都值钱。
+  __attribute__((optimize("-O3")))
+  bool Panel_EPD::copy_region_out_fast(int32_t x0, int32_t y0, int32_t w, int32_t h, uint8_t* dst)
+  {
+    if (_buf == nullptr || dst == nullptr || w <= 0 || h <= 0) { return false; }
+    const int32_t pw = _cfg.panel_width, ph = _cfg.panel_height;
+    const int32_t stride  = (pw + 1) >> 1;
+    const int32_t dstride = (w + 1) >> 1;
+    const uint_fast8_t r  = _internal_rotation;
+    const uint_fast8_t rb = 1 << r;
+    const int sw = (r & 1) ? 1 : 0;
+    const int fx = (rb & 0b11000110) ? 1 : 0;
+    const int fy = (rb & 0b10011100) ? 1 : 0;
+
+    auto map = [&](int32_t xi, int32_t yj, int32_t& ox, int32_t& oy) {
+      int32_t x = xi, y = yj;
+      if (sw) { int32_t t = x; x = y; y = t; }
+      if (fx) { x = pw - 1 - x; }
+      if (fy) { y = ph - 1 - y; }
+      ox = x; oy = y;
+    };
+
+    int32_t x00, y00, x10, y10, x01, y01;
+    map(x0,     y0,     x00, y00);
+    map(x0 + 1, y0,     x10, y10);
+    map(x0,     y0 + 1, x01, y01);
+    const int32_t ax = x10 - x00, ay = y10 - y00;   // 每像素增量
+    const int32_t bx = x01 - x00, by = y01 - y00;   // 每行增量
+
+    // 逐像素兜底（越界要"跳过不写"，与原版一致）—— 只有边缘块用它
+    auto one = [&](int32_t i, int32_t j, uint8_t& out) -> bool {
+      const int32_t x = x00 + ax * i + bx * j;
+      const int32_t y = y00 + ay * i + by * j;
+      if (x < 0 || y < 0 || x >= pw || y >= ph) return false;
+      const uint8_t byte = _buf[(size_t)(x >> 1) + (size_t)y * stride];
+      out = (x & 1) ? (byte & 0x0F) : (uint8_t)(byte >> 4);
+      return true;
+    };
+    auto put = [&](uint8_t* drow, int32_t i, uint8_t v) {
+      if (i & 1) drow[i >> 1] |= v;
+      else       drow[i >> 1] = (uint8_t)(v << 4);
+    };
+
+    // ── 情形 A：ay == 0 —— 目标行映射到源里**连续**的一段，顺序读就行，分块没意义 ──
+    if (ay == 0)
+    {
+      for (int32_t j = 0; j < h; ++j)
+      {
+        uint8_t* drow = dst + (size_t)j * dstride;
+        for (int32_t i = 0; i < w; ++i)
+        {
+          uint8_t v;
+          if (one(i, j, v)) put(drow, i, v);
+        }
+      }
+      return true;
+    }
+
+    // ── 情形 B：转置（ax == 0, ay = ±1）—— 2D 分块 ──
+    //   不分块时：目标第 j 行 ← 源第 x 列，逐像素跳 stride(=270) 字节
+    //   → 一个 32B cache line 只用 1 个 nibble（32 倍浪费）。
+    //   分块后：源侧一次读 TB 个连续 nibble、目标侧一次写 TC 个连续 nibble，
+    //   每块(TC×TB=512 像素)的 cache line 数从 512 降到 ~(TC+TB)=48。
+    //   ★ 边界块（块内出现越界像素）直接退回逐像素版 —— 块很小，且这样绝不改变
+    //     "越界=跳过不写"的语义。
+    constexpr int32_t TB = 32;   // 目标列块宽（= 源侧一行里连续 nibble 数）
+    constexpr int32_t TC = 16;   // 目标行块高
+    static uint8_t tile[TC][TB];
+
+    for (int32_t j0 = 0; j0 < h; j0 += TB)
+    {
+      const int32_t j1 = (j0 + TB < h) ? (j0 + TB) : h;
+      const int32_t xa = x00 + ax * 0    + bx * j0;          // 该块 x 范围（ax=0）
+      const int32_t xb2 = x00 + ax * 0   + bx * (j1 - 1);
+      const int32_t xlo = (xa < xb2) ? xa : xb2, xhi = (xa < xb2) ? xb2 : xa;
+
+      for (int32_t i0 = 0; i0 < w; i0 += TC)
+      {
+        const int32_t i1 = (i0 + TC < w) ? (i0 + TC) : w;
+        const int32_t ya = y00 + ay * i0  + by * 0;
+        const int32_t yb2 = y00 + ay * (i1 - 1) + by * 0;
+        const int32_t ylo = (ya < yb2) ? ya : yb2, yhi = (ya < yb2) ? yb2 : ya;
+
+        if (xlo >= 0 && xhi < pw && ylo >= 0 && yhi < ph)
+        {
+          // ① 收集：每个源行 y 读 TB 个**连续** nibble
+          for (int32_t i = i0; i < i1; ++i)
+          {
+            const uint8_t* srow = &_buf[(size_t)(y00 + ay * i) * stride];
+            const int32_t  xbase = x00 + bx * j0;
+            for (int32_t j = j0; j < j1; ++j)
+            {
+              const int32_t x = xbase + bx * (j - j0);
+              const uint8_t byte = srow[x >> 1];
+              tile[i - i0][j - j0] = (x & 1) ? (byte & 0x0F) : (uint8_t)(byte >> 4);
+            }
+          }
+          // ② 写出：目标每行写 TC 个**连续** nibble
+          for (int32_t j = j0; j < j1; ++j)
+          {
+            uint8_t* drow = dst + (size_t)j * dstride;
+            for (int32_t i = i0; i < i1; ++i) put(drow, i, tile[i - i0][j - j0]);
+          }
+        }
+        else
+        {
+          for (int32_t j = j0; j < j1; ++j)
+          {
+            uint8_t* drow = dst + (size_t)j * dstride;
+            for (int32_t i = i0; i < i1; ++i)
+            {
+              uint8_t v;
+              if (one(i, j, v)) put(drow, i, v);
+            }
+          }
+        }
+      }
+    }
+    return true;
+  }
