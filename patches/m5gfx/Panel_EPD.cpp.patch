+  bool Panel_EPD::copy_region_in(int32_t x0, int32_t y0, int32_t w, int32_t h, const uint8_t* src)
+  {
+    if (_buf == nullptr || src == nullptr || w <= 0 || h <= 0) { return false; }
+    const size_t stride = (size_t)((_cfg.panel_width + 1) >> 1);
+    const size_t sstride = (size_t)((w + 1) >> 1);
+    const uint_fast8_t r = _internal_rotation;
+    for (int32_t j = 0; j < h; ++j)
+    {
+      const uint8_t* srow = src + (size_t)j * sstride;
+      for (int32_t i = 0; i < w; ++i)
+      {
+        int32_t x = x0 + i, y = y0 + j;
+        if (r & 1) { int32_t t = x; x = y; y = t; }
+        const uint_fast8_t rb = 1 << r;
+        if (rb & 0b11000110) { x = _cfg.panel_width  - 1 - x; }
+        if (rb & 0b10011100) { y = _cfg.panel_height - 1 - y; }
+        if (x < 0 || y < 0 || x >= _cfg.panel_width || y >= _cfg.panel_height) { continue; }
+        const uint8_t v = (i & 1) ? (srow[i >> 1] & 0x0F) : (uint8_t)(srow[i >> 1] >> 4);
+        uint8_t* p = &_buf[(size_t)(x >> 1) + (size_t)y * stride];
+        if (x & 1) { *p = (uint8_t)((*p & 0xF0) | v); }
+        else       { *p = (uint8_t)((*p & 0x0F) | (v << 4)); }
+      }
+    }
+    return true;
+  }
