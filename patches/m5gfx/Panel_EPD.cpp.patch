+bool Panel_EPD::copy_region_out(int32_t x0, int32_t y0, int32_t w, int32_t h, uint8_t* dst)
+  {
+    if (_buf == nullptr || dst == nullptr || w <= 0 || h <= 0) { return false; }
+    const size_t stride = (size_t)((_cfg.panel_width + 1) >> 1);   // _buf row stride, in bytes
+    const size_t dstride = (size_t)((w + 1) >> 1);                 // destination row stride
+    const uint_fast8_t r = _internal_rotation;
+    for (int32_t j = 0; j < h; ++j)
+    {
+      uint8_t* drow = dst + (size_t)j * dstride;
+      for (int32_t i = 0; i < w; ++i)
+      {
+        int32_t x = x0 + i, y = y0 + j;
+        // identical mapping to _draw_pixels(), recomputed per pixel
+        if (r & 1) { int32_t t = x; x = y; y = t; }
+        const uint_fast8_t rb = 1 << r;
+        if (rb & 0b11000110) { x = _cfg.panel_width  - 1 - x; }
+        if (rb & 0b10011100) { y = _cfg.panel_height - 1 - y; }
+        if (x < 0 || y < 0 || x >= _cfg.panel_width || y >= _cfg.panel_height) { continue; }
+        const uint8_t* p = &_buf[(size_t)(x >> 1) + (size_t)y * stride];
+        const uint8_t v = (x & 1) ? (*p & 0x0F) : (uint8_t)(*p >> 4);
+        if (i & 1) { drow[i >> 1] |= v; }
+        else       { drow[i >> 1] = (uint8_t)(v << 4); }
+      }
+    }
+    return true;
+  }
