# M5Paper S3 (ESP32-S3R8)，16MB Flash，8MB Octal PSRAM
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM：S3R8 是八线(Octal) PSRAM，必须开 OCT 模式，
# 配成 Quad 会在启动时 panic（quad_psram: PSRAM chip is not connected, or wrong PSRAM line mode）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 允许从 PSRAM 取指令：elf_loader 把 .so 加载进 PSRAM 后要靠它执行
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# 主任务栈：M5GFX 自动探测 + app_main 里放 App 对象（World 约 1.3KB）
# 默认 3584 字节不够，会踩栈 → 表现为 spi/中断分配里 LoadProhibited
# （M5 官方 PaperS3 demo 也把这里设成 6000）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LWIP (WiFi)
CONFIG_LWIP_MAX_SOCKETS=16

# FATFS：默认只认 8.3 短名（LFN_NONE），中文文件名/长文件名在读目录时就没了。
#   LFN_HEAP   = 长名缓冲放堆（放栈怕溢出）
#   API_UTF_8  = FF_LFN_UNICODE=2，FATFS API 的路径/名字用 UTF-8（这一条才是中文能显示的关键）
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# elf_loader：运行时从 SD 卡加载 .so 插件页
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS=y
CONFIG_ELF_FILE_SYSTEM_BASE_PATH="/sdcard"

# CPU 占用率（.so 的 so_cpu_load 要用）：FreeRTOS 运行时间统计，计数器用 esp_timer
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
